\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces MEHDIE benchmark F-5 scores at threshold 0.9. MEHDIE system results from\nobreakspace  {}\citet  {mehdie2025}. Symphonym's lower performance reflects different design goals: MEHDIE uses explicit phonetic transcription via Phonetisaurus G2P optimized for medieval Arabic-Hebrew matching, while Symphonym learns implicit cross-script phonetic representations from modern multilingual gazetteer data. The performance gap reflects Symphonym's generalist architecture rather than training data deficiencies: the model prioritizes transfer across 20 scripts over optimization for specific historical language pairs.\relax }}{31}{table.caption.52}\protected@file@percent }
\newlabel{tab:mehdie-results}{{5}{31}{MEHDIE benchmark F-5 scores at threshold 0.9. MEHDIE system results from~\citet {mehdie2025}. Symphonym's lower performance reflects different design goals: MEHDIE uses explicit phonetic transcription via Phonetisaurus G2P optimized for medieval Arabic-Hebrew matching, while Symphonym learns implicit cross-script phonetic representations from modern multilingual gazetteer data. The performance gap reflects Symphonym's generalist architecture rather than training data deficiencies: the model prioritizes transfer across 20 scripts over optimization for specific historical language pairs.\relax }{table.caption.52}{}}
\newlabel{tab:mehdie-results@cref}{{[table][5][]5}{[1][31][]31}}
