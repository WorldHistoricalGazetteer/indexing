\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces MEHDIE Hebrew-Arabic historical benchmark\nobreakspace  {}\citep  {mehdie2025}: unweighted mean across five testsets (137 queries), the benchmark's own convention. String baselines were re-run rather than quoted and reproduce their published values to within 0.1 points, confirming like-for-like aggregation. R@5 is unchanged between generations and R@10 moves 0.6 points, while R@1 gains 4.1: the improvement is in ranking, not reach.\relax }}{20}{table.caption.40}\protected@file@percent }
\newlabel{tab:mehdie-ranking}{{1}{20}{MEHDIE Hebrew-Arabic historical benchmark~\citep {mehdie2025}: unweighted mean across five testsets (137 queries), the benchmark's own convention. String baselines were re-run rather than quoted and reproduce their published values to within 0.1 points, confirming like-for-like aggregation. R@5 is unchanged between generations and R@10 moves 0.6 points, while R@1 gains 4.1: the improvement is in ranking, not reach.\relax }{table.caption.40}{}}
\newlabel{tab:mehdie-ranking@cref}{{[table][1][]1}{[1][20][]20}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Recall@1 against string baselines, each query ranked against twenty-one candidates. Phonetic embedding and string distance fail in different places: across scripts the string metrics do not function at all, while within the Latin script they are the better instrument. The two are complementary channels, not competitors.\relax }}{21}{table.caption.41}\protected@file@percent }
\newlabel{tab:vstraditional}{{2}{21}{Recall@1 against string baselines, each query ranked against twenty-one candidates. Phonetic embedding and string distance fail in different places: across scripts the string metrics do not function at all, while within the Latin script they are the better instrument. The two are complementary channels, not competitors.\relax }{table.caption.41}{}}
\newlabel{tab:vstraditional@cref}{{[table][2][]2}{[1][21][]21}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Proportion of each band clearing the 0.7 production retrieval gate, over 319 queries. In the first generation a meaningless anagram was retrievable almost as often as a genuine variant, because nothing in training made character order matter. Permutation negatives close the gap without sacrificing tolerance of typographic errors, which is the distinction required: some reordering is a typing slip, and some destroys the name.\relax }}{22}{table.caption.42}\protected@file@percent }
\newlabel{tab:order}{{3}{22}{Proportion of each band clearing the 0.7 production retrieval gate, over 319 queries. In the first generation a meaningless anagram was retrievable almost as often as a genuine variant, because nothing in training made character order matter. Permutation negatives close the gap without sacrificing tolerance of typographic errors, which is the distinction required: some reordering is a typing slip, and some destroys the name.\relax }{table.caption.42}{}}
\newlabel{tab:order@cref}{{[table][3][]3}{[1][22][]22}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Retrieval over one fixed haystack of 1,053,229 names with 4,843 queries, both generations scored on the same corpus and queries. Every retrieval metric improves, but recall@200 least of all: the gain is in ordering. Since 200 is the deployed candidate-pool size, recall@200 = 0.4908 is a ceiling that no downstream re-ranking can raise. Discrimination moved in the opposite direction.\relax }}{23}{table.caption.43}\protected@file@percent }
\newlabel{tab:retrieval}{{4}{23}{Retrieval over one fixed haystack of 1,053,229 names with 4,843 queries, both generations scored on the same corpus and queries. Every retrieval metric improves, but recall@200 least of all: the gain is in ordering. Since 200 is the deployed candidate-pool size, recall@200 = 0.4908 is a ceiling that no downstream re-ranking can raise. Discrimination moved in the opposite direction.\relax }{table.caption.43}{}}
\newlabel{tab:retrieval@cref}{{[table][4][]4}{[1][23][]23}}
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Mean cosine similarity for representative script pairs. The CJK-Hiragana row is the correction of Section\nobreakspace  {}\ref  {subsec:contamination}: the score \emph  {falls}, and falling is correct, because the first generation's higher value arose from Chinese toponyms transcribed with Japanese readings. Overall pass rate at the 0.75 threshold is essentially unchanged between generations (90.7\% against 90.8\%).\relax }}{24}{table.caption.44}\protected@file@percent }
\newlabel{tab:scriptpairs}{{5}{24}{Mean cosine similarity for representative script pairs. The CJK-Hiragana row is the correction of Section~\ref {subsec:contamination}: the score \emph {falls}, and falling is correct, because the first generation's higher value arose from Chinese toponyms transcribed with Japanese readings. Overall pass rate at the 0.75 threshold is essentially unchanged between generations (90.7\% against 90.8\%).\relax }{table.caption.44}{}}
\newlabel{tab:scriptpairs@cref}{{[table][5][]5}{[1][24][]24}}
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces Four candidate models scored on one frozen test set under a rule fixed before any candidate finished. Arm \textbf  {A} was selected. B and G lead the headline figure by roughly twelve pairs in four thousand, while A leads the collateral measures by larger margins and is the only candidate with no regression on historical Latin pairs. Note arm \textbf  {M}: it achieved the best validation loss at all three training phases and is the worst of the four in deployment. Phase loss orders candidates within a fixed objective and does not compare across recipes.\relax }}{25}{table.caption.45}\protected@file@percent }
\newlabel{tab:arms}{{6}{25}{Four candidate models scored on one frozen test set under a rule fixed before any candidate finished. Arm \textbf {A} was selected. B and G lead the headline figure by roughly twelve pairs in four thousand, while A leads the collateral measures by larger margins and is the only candidate with no regression on historical Latin pairs. Note arm \textbf {M}: it achieved the best validation loss at all three training phases and is the worst of the four in deployment. Phase loss orders candidates within a fixed objective and does not compare across recipes.\relax }{table.caption.45}{}}
\newlabel{tab:arms@cref}{{[table][6][]6}{[1][25][]25}}
