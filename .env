# =============================================================================
# WHG Elasticsearch Environment Configuration
# =============================================================================

# --- Base Paths ---
IX1_BASE="/ix1/ishi"
IX3_BASE="/vast/ishi"

# --- Repository ---
REPO_URL="git@github.com:WorldHistoricalGazetteer/elastic.git"

# The repository lives on /vast. It used to be ${IX1_BASE}/elastic, with the
# /vast copy as a shallow operational clone kept in sync by `es -update`; the
# /ix1 clone is gone (relocated 2026-05-01 to put Python imports, log writes
# and Slurm WorkDir on flash). REPO_DIR still pointed at the retired path until
# 2026-08-02, which silently broke every consumer that does a bare
# `cd "$REPO_DIR"` — `scripts/types.sh` had been dying on it for three months,
# taking the AAT vocabulary refresh with it. `scripts/es.sh` survived only
# because it happens to fall back to VAST_REPO_DIR; `scripts/model.sh` does not.
REPO_DIR="${IX3_BASE}/elastic"

# Retained as an alias so anything still naming it explicitly keeps working.
VAST_REPO_DIR="${IX3_BASE}/elastic"

# --- Binaries ---
ES_HOME="${IX1_BASE}/es-bin"
# Kibana lives on /vast (flash): loading its ~173 plugins is thousands of
# small-file reads, pathologically slow on the /ix1 NFSv4 mount (30+ min cold
# start). /vast brings it down to a few minutes. See scripts/boot_start_whg.sh.
KIBANA_HOME="${IX3_BASE}/kibana-bin"
JAVA_HOME="${IX1_BASE}/jdk-21.0.1"

# Elasticsearch and Kibana versions
ES_VERSION="9.0.0"
KIBANA_VERSION="9.0.0"

# Download URLs
ES_DOWNLOAD_URL="https://artifacts.elastic.co/downloads/elasticsearch/elasticsearch-${ES_VERSION}-linux-x86_64.tar.gz"
KIBANA_DOWNLOAD_URL="https://artifacts.elastic.co/downloads/kibana/kibana-${KIBANA_VERSION}-linux-x86_64.tar.gz"

# --- Authority Source Data ---
DATA_DIR="${IX1_BASE}/data"

# --- Snapshot Repositories ---
# Shared location accessible by both staging (CRC) and production (VM)
SNAPSHOT_DIR="${IX1_BASE}/es/snapshots"
STAGING_SNAPSHOT_DIR="${SNAPSHOT_DIR}/staging"
BACKUP_SNAPSHOT_DIR="${SNAPSHOT_DIR}/backup"

# Repository names (as registered in ES)
STAGING_REPO_NAME="staging_repo"

# Where a staging node RESTORES FROM. Deliberately separate from
# STAGING_REPO_NAME, which is where staging WRITES its own checkpoints.
# Conflating the two is how a staging restore came to select
# `promote-h3ccode-20260805t120000z` on 2026-09-05: the newest snapshot in
# `staging_repo` containing a places index was six weeks stale AND places-only,
# so every phonetic pass on the restored node would have returned nothing while
# appearing to work. `prod_repo` is the repo SLM now writes production backups
# to. It sits under SNAPSHOT_DIR, which is already the staging node's path.repo,
# so no allowlist change is needed. Registered READONLY on staging (see
# es_staging.sbatch): a staging node reads production's backups and must never
# write to them.
RESTORE_REPO_NAME="prod_repo"
RESTORE_SNAPSHOT_DIR="${SNAPSHOT_DIR}/prod"
BACKUP_REPO_NAME="backup_repo"

# Cluster exchange: snapshot handoff between production and staging
CLUSTER_EXCHANGE_DIR="${SNAPSHOT_DIR}/cluster_exchange"
CLUSTER_EXCHANGE_REPO="cluster_exchange"

# =============================================================================
# PRODUCTION (VM)
# =============================================================================

# ES internal (localhost only, behind the gateway)
PROD_ES_HOST="localhost"
PROD_ES_BIND_HOST="localhost"
PROD_ES_INTERNAL_PORT="9201"
PROD_ES_PORT="${PROD_ES_INTERNAL_PORT}"
PROD_ES_URL="http://${PROD_ES_HOST}:${PROD_ES_INTERNAL_PORT}"

# Extra hostnames that also mean "production", beyond PROD_ES_HOST. Consulted by
# processing.settings.is_production_host, which guards full-rebuild tools against
# building into the live cluster instead of staging. PROD_ES_HOST is "localhost"
# because ES binds locally on the VM, so the VM's own name has to be listed here
# for the guard to fire when a tool is pointed at it by name from elsewhere.
PROD_ES_HOSTNAMES="gazetteer.crcd.pitt.edu,whg-prod-1"

# API Gateway (external-facing, only port open through CRC firewall)
# Routes: kibana.whgazetteer.org → Kibana, everything else → ES
GATEWAY_HOST="0.0.0.0"
GATEWAY_PORT="9200"

PROD_CLUSTER_NAME="whg-production"
PROD_NODE_NAME="whg-prod-1"

# Public hostnames (DNS CNAME -> gazetteer.crcd.pitt.edu)
KIBANA_PUBLIC_HOST="kibana.whgazetteer.org"
INDEX_PUBLIC_HOST="index.whgazetteer.org"

# Kibana (localhost only, behind the gateway)
KIBANA_PORT="5601"

# TLS certificates (Let's Encrypt via certbot, user-space)
# certbot dirs under IX1_BASE (no root required)
CERTBOT_CONFIG_DIR="${IX1_BASE}/certbot/config"
CERTBOT_WORK_DIR="${IX1_BASE}/certbot/work"
CERTBOT_LOGS_DIR="${IX1_BASE}/certbot/logs"
CERT_DIR="${CERTBOT_CONFIG_DIR}/live/kibana.whgazetteer.org"
SSL_CERT="${CERT_DIR}/fullchain.pem"
SSL_KEY="${CERT_DIR}/privkey.pem"

# Production data on fast storage
PROD_DATA_DIR="${IX3_BASE}/es/data"
PROD_LOG_DIR="${IX1_BASE}/es/logs"
PROD_CONFIG_DIR="${IX1_BASE}/es/config"

# PID files
PROD_ES_PID="${IX1_BASE}/es/es.pid"
KIBANA_PID="${IX3_BASE}/kibana/kb.pid"

# =============================================================================
# STAGING (Slurm compute node)
# =============================================================================

STAGING_ES_PORT="9201"
STAGING_CLUSTER_NAME="whg-staging"
STAGING_NODE_NAME="whg-staging-1"

# Connection info file (written by sbatch, read by other jobs/scripts)
STAGING_INFO_FILE="${IX1_BASE}/esinfo/es-staging.env"

# Slurm job logs
STAGING_SLURM_LOGS="${IX1_BASE}/es/staging-logs"

# =============================================================================
# INDEXING SETTINGS
# =============================================================================

BATCH_SIZE="5000"

# =============================================================================
# INDEX NAMES
# =============================================================================

PLACES_INDEX="places"
TOPONYMS_INDEX="toponyms"