# --- NFS MOUNT ---
NFS_MOUNT="/ix1/whcdh"

# --- Elasticsearch and Kibana Binary Paths ---
ES_BIN_PATH="${NFS_MOUNT}/es-bin/bin/elasticsearch"
KB_BIN_PATH="${NFS_MOUNT}/kibana-bin/bin/kibana"

# --- Elasticsearch Data Paths ---
# Data paths for the primary instance
ES_DATA_PATH="${NFS_MOUNT}/es/data"
ES_LOGS_PATH="${NFS_MOUNT}/es/logs"
ES_REPO_ROOT="${NFS_MOUNT}/es/repo" # The main allowed path for snapshots

# --- Elasticsearch Connection ---
ES_HOST_PORT="9200"
ES_HOST_NAME="localhost"
ES_HOST_URL="http://${ES_HOST_NAME}:${ES_HOST_PORT}"
ES_CLUSTER_NAME="es-production"
ES_NODE_NAME="es-production-node-1"

# --- PID Files ---
ES_PID_FILE="${NFS_MOUNT}/es/es.pid"
KB_PID_FILE="${NFS_MOUNT}/kibana/kb.pid"

# --- Python Script (Snapshot) Configuration ---
# Logical repository names and their subdirectories within ES_REPO_ROOT
ES_STAGING_REPO_NAME="staging_repo"
ES_STAGING_REPO_LOCATION="${ES_REPO_ROOT}/staging"
ES_BACKUP_REPO_NAME="longterm_backup_repo"
ES_BACKUP_REPO_LOCATION="${ES_REPO_ROOT}/longterm"

# --- General Data Directory ---
DATA_DIR="${NFS_MOUNT}/data"