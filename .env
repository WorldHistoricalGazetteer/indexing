# =============================================================================
# WHG Elasticsearch Environment Configuration
# =============================================================================

# --- Base Paths ---
IX1_BASE="/ix1/whcdh"
IX3_BASE="/ix3/whcdh"

# --- Repository ---
REPO_URL="git@github.com:WorldHistoricalGazetteer/elastic.git"
REPO_DIR="${IX1_BASE}/elastic"

# --- Binaries ---
ES_HOME="${IX1_BASE}/es-bin"
KIBANA_HOME="${IX1_BASE}/kibana-bin"
JAVA_HOME="${IX1_BASE}/jdk-21.0.1"

# Elasticsearch and Kibana versions
ES_VERSION="9.0.0"
KIBANA_VERSION="9.0.0"

# Download URLs
ES_DOWNLOAD_URL="https://artifacts.elastic.co/downloads/elasticsearch/elasticsearch-${ES_VERSION}-linux-x86_64.tar.gz"
KIBANA_DOWNLOAD_URL="https://artifacts.elastic.co/downloads/kibana/kibana-${KIBANA_VERSION}-linux-x86_64.tar.gz"

# --- Authority Source Data ---
DATA_DIR="${IX1_BASE}/data/authorities"

# --- Snapshot Repositories ---
# Shared location accessible by both staging (CRC) and production (VM)
SNAPSHOT_DIR="${IX1_BASE}/es/snapshots"
STAGING_SNAPSHOT_DIR="${SNAPSHOT_DIR}/staging"
BACKUP_SNAPSHOT_DIR="${SNAPSHOT_DIR}/backup"

# Repository names (as registered in ES)
STAGING_REPO_NAME="staging_repo"
BACKUP_REPO_NAME="backup_repo"

# =============================================================================
# PRODUCTION (VM)
# =============================================================================

PROD_ES_HOST="localhost"
PROD_ES_PORT="9200"
PROD_ES_URL="http://${PROD_ES_HOST}:${PROD_ES_PORT}"

PROD_CLUSTER_NAME="whg-production"
PROD_NODE_NAME="whg-prod-1"

# Production data on fast storage
PROD_DATA_DIR="${IX3_BASE}/es/data"
PROD_LOG_DIR="${IX1_BASE}/es/logs"
PROD_CONFIG_DIR="${IX1_BASE}/es/config"

# PID files
PROD_ES_PID="${IX1_BASE}/es/es.pid"
KIBANA_PID="${IX1_BASE}/kibana/kb.pid"

# =============================================================================
# STAGING (Slurm compute node)
# =============================================================================

STAGING_ES_PORT="9201"
STAGING_CLUSTER_NAME="whg-staging"
STAGING_NODE_NAME="whg-staging-1"

# Connection info file (written by sbatch, read by other jobs/scripts)
STAGING_INFO_FILE="${IX1_BASE}/esinfo/es-staging.env"

# Slurm job logs
STAGING_SLURM_LOGS="${IX1_BASE}/es/staging-logs"

# =============================================================================
# INDEXING SETTINGS
# =============================================================================

BATCH_SIZE="5000"

# =============================================================================
# INDEX NAMES
# =============================================================================

PLACES_INDEX="places"
TOPONYMS_INDEX="toponyms"