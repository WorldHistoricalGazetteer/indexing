# --- Elasticsearch and Kibana Binary Paths ---
ES_BIN_PATH="/ix1/whcdh/es-bin/bin/elasticsearch"
KB_BIN_PATH="/ix1/whcdh/kibana-bin/bin/kibana"

# --- Elasticsearch Data Paths ---
# Data paths for the primary instance
ES_DATA_PATH="/ix1/whcdh/es/data"
ES_LOGS_PATH="/ix1/whcdh/es/logs"
ES_REPO_ROOT="/ix1/whcdh/es/repo" # The main allowed path for snapshots

# --- Elasticsearch Connection ---
ES_HOST_URL="http://localhost:9200"

# --- PID Files ---
ES_PID_FILE="/ix1/whcdh/es/es.pid"
KB_PID_FILE="/ix1/whcdh/kibana/kb.pid"

# --- Python Script (Snapshot) Configuration ---
# Logical repository names and their subdirectories within ES_REPO_ROOT
ES_STAGING_REPO_NAME="staging_repo"
ES_STAGING_REPO_LOCATION="${ES_REPO_ROOT}/staging"
ES_BACKUP_REPO_NAME="longterm_backup_repo"
ES_BACKUP_REPO_LOCATION="${ES_REPO_ROOT}/longterm"

# --- General Data Directory ---
DATA_DIR="/ix1/whcdh/data"