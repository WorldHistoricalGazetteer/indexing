{
  "settings": {
    "number_of_shards": 1,
    "number_of_replicas": 0,
    "refresh_interval": "-1",
    "index": {
      "codec": "best_compression",
      "translog.durability": "async",
      "translog.sync_interval": "5s",
      "translog.flush_threshold_size": "1gb"
    },
    "analysis": {
      "normalizer": {
        "lowercase_normalizer": {
          "type": "custom",
          "filter": ["lowercase"]
        }
      },
      "analyzer": {
        "boundary_analyzer": {
          "tokenizer": "standard",
          "filter": ["lowercase", "asciifolding"]
        },
        "edge_ngram_analyzer": {
          "tokenizer": "edge_ngram_tokenizer",
          "filter": ["lowercase", "asciifolding"]
        }
      },
      "tokenizer": {
        "edge_ngram_tokenizer": {
          "type": "edge_ngram",
          "min_gram": 2,
          "max_gram": 20,
          "token_chars": ["letter", "digit"]
        }
      }
    }
  },
  "mappings": {
    "properties": {
      "boundary_id": {
        "type": "keyword"
      },
      "namespace": {
        "type": "keyword"
      },
      "name": {
        "type": "text",
        "analyzer": "boundary_analyzer",
        "fields": {
          "keyword": {
            "type": "keyword"
          },
          "raw": {
            "type": "keyword",
            "normalizer": "lowercase_normalizer"
          },
          "prefix": {
            "type": "text",
            "analyzer": "edge_ngram_analyzer",
            "search_analyzer": "standard"
          }
        }
      },
      "name_local": {
        "type": "text",
        "analyzer": "boundary_analyzer",
        "fields": {
          "keyword": {
            "type": "keyword"
          }
        }
      },
      "alt_names": {
        "type": "object",
        "enabled": false
      },
      "admin_level": {
        "type": "integer"
      },
      "geom": {
        "type": "geo_shape"
      },
      "hull": {
        "type": "geo_shape"
      },
      "bounds": {
        "type": "float"
      },
      "repr_point": {
        "type": "geo_point"
      },
      "ccodes": {
        "type": "keyword"
      },
      "population": {
        "type": "long"
      },
      "wikidata_id": {
        "type": "keyword"
      },
      "source": {
        "type": "keyword"
      },
      "timespans": {
        "type": "nested",
        "properties": {
          "start": {
            "type": "object",
            "properties": {
              "in": { "type": "integer" }
            }
          },
          "end": {
            "type": "object",
            "properties": {
              "in": { "type": "integer" }
            }
          }
        }
      },
      "indexed_at": {
        "type": "date"
      }
    }
  }
}

