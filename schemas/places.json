{
  "settings": {
    "number_of_shards": 4,
    "number_of_replicas": 0,
    "refresh_interval": "-1",
    "max_result_window": 10000,
    "index": {
      "codec": "best_compression",
      "translog.durability": "async",
      "translog.sync_interval": "5s",
      "translog.flush_threshold_size": "2gb",
      "sort.field": ["place_id"],
      "sort.order": ["asc"]
    }
  },
  "mappings": {
    "properties": {
      "place_id": {
        "type": "keyword"
      },
      "namespace": {
        "type": "keyword"
      },
      "dataset_status": {
        "type": "keyword"
      },
      "dataset_id": {
        "type": "keyword"
      },
      "title": {
        "type": "text",
        "fields": {
          "keyword": {
            "type": "keyword",
            "ignore_above": 256
          }
        }
      },
      "toponyms": {
        "type": "nested",
        "properties": {
          "toponym_id": {
            "type": "keyword"
          },
          "label": {
            "type": "text",
            "fields": {
              "keyword": {
                "type": "keyword",
                "ignore_above": 256
              }
            }
          },
          "timespans": {
            "type": "nested",
            "properties": {
              "start": {
                "type": "object",
                "properties": {
                  "in": {
                    "type": "integer"
                  }
                }
              },
              "end": {
                "type": "object",
                "properties": {
                  "in": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        }
      },
      "geometries": {
        "type": "nested",
        "properties": {
          "has_geom": {
            "type": "boolean"
          },
          "source": {
            "type": "keyword",
            "_comment": "Namespace the geometry was sourced/derived from: the record's own namespace when inherent in the source (e.g. 'og'); 'ofs' for a hull WHG computed from another namespace's component points; 'wd' for a geometry pulled from a linked Wikidata record. Absent on legacy docs = source-inherent."
          },
          "approximation": {
            "type": "keyword",
            "_comment": "Nature of the geometry vs the true extent: 'exact' (or absent) for a faithful source geometry; 'convex_hull' | 'concave_hull' | 'bbox' | 'centroid' for a WHG-computed approximation."
          },
          "repr_point": {
            "type": "geo_point"
          },
          "hull": {
            "type": "geo_shape"
          },
          "bounds": {
            "type": "float"
          },
          "h3_centroid": {
            "type": "keyword"
          },
          "h3_cover": {
            "type": "keyword"
          },
          "timespans": {
            "type": "nested",
            "properties": {
              "start": {
                "type": "object",
                "properties": {
                  "in": {
                    "type": "integer"
                  }
                }
              },
              "end": {
                "type": "object",
                "properties": {
                  "in": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        }
      },
      "types": {
        "type": "nested",
        "properties": {
          "identifier": {
            "type": "keyword"
          },
          "label": {
            "type": "text"
          },
          "sourceLabel": {
            "type": "keyword"
          },
          "aat_ids": {
            "type": "long"
          },
          "aat_paths": {
            "type": "keyword"
          }
        }
      },
      "ccodes": {
        "type": "keyword"
      },
      "population": {
        "type": "long"
      },
      "elevation": {
        "type": "integer"
      },
      "relations": {
        "type": "nested",
        "properties": {
          "relation_type": {
            "type": "keyword"
          },
          "related_place_id": {
            "type": "keyword"
          },
          "label": {
            "type": "text"
          },
          "timespans": {
            "type": "nested",
            "properties": {
              "start": {
                "type": "object",
                "properties": {
                  "in": {
                    "type": "integer"
                  }
                }
              },
              "end": {
                "type": "object",
                "properties": {
                  "in": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        }
      },
      "links": {
        "type": "nested",
        "properties": {
          "type": {
            "type": "keyword"
          },
          "identifier": {
            "type": "keyword"
          }
        }
      },
      "descriptions": {
        "type": "nested",
        "properties": {
          "value": {
            "type": "text"
          },
          "lang": {
            "type": "keyword"
          }
        }
      },
      "depictions": {
        "type": "nested",
        "properties": {
          "@id": {
            "type": "keyword"
          },
          "title": {
            "type": "text"
          },
          "license": {
            "type": "keyword"
          }
        }
      },
      "boundary": {
        "type": "keyword"
      },
      "indexed_at": {
        "type": "date"
      }
    }
  }
}
