{
  "settings": {
    "index": {
      "number_of_shards": 4,
      "number_of_replicas": 0,
      "refresh_interval": "-1",
      "translog": {
        "durability": "async",
        "flush_threshold_size": "1gb"
      }
    },
    "analysis": {
      "normalizer": {
        "lowercase_normalizer": {
          "type": "custom",
          "filter": ["lowercase"]
        }
      },
      "analyzer": {
        "toponym_analyzer": {
          "tokenizer": "standard",
          "filter": ["lowercase", "asciifolding"]
        },
        "edge_ngram_analyzer": {
          "tokenizer": "edge_ngram_tokenizer",
          "filter": ["lowercase", "asciifolding"]
        }
      },
      "tokenizer": {
        "edge_ngram_tokenizer": {
          "type": "edge_ngram",
          "min_gram": 2,
          "max_gram": 20,
          "token_chars": ["letter", "digit"]
        }
      }
    }
  },
  "mappings": {
    "properties": {
      "toponym_id": { "type": "keyword" },
      "name": {
        "type": "text",
        "analyzer": "toponym_analyzer",
        "fields": {
          "keyword": { "type": "keyword" },
          "raw": {
            "type": "keyword",
            "normalizer": "lowercase_normalizer"
          },
          "prefix": {
            "type": "text",
            "analyzer": "edge_ngram_analyzer",
            "search_analyzer": "standard"
          }
        }
      },
      "name_romanized": {
        "type": "text",
        "analyzer": "toponym_analyzer",
        "fields": {
          "keyword": { "type": "keyword" },
          "prefix": {
            "type": "text",
            "analyzer": "edge_ngram_analyzer",
            "search_analyzer": "standard"
          }
        }
      },
      "lang": { "type": "keyword" },
      "lang_variant": { "type": "keyword" },
      "script": { "type": "keyword" },
      "namespaces": { "type": "keyword" },
      "primary_namespace": { "type": "keyword" },
      "attestations": { "type": "keyword" },

      "ipa": { "type": "keyword", "index": false },
      "panphon_embedding": {
        "type": "dense_vector",
        "dims": 192,
        "index": true,
        "similarity": "cosine"
      },

      "embedding": {
        "type": "dense_vector",
        "dims": 128,
        "index": true,
        "similarity": "cosine",
        "element_type": "byte"
      },
      "embedding_version": { "type": "integer" },
      "indexed_at": { "type": "date" }
    }
  }
}